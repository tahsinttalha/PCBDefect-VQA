():\n    json_v3 = os.path.join(WORKDIR, \"hybrid_pcb_vqa_v3.json\")\n    meta_v3 = os.path.join(WORKDIR, \"meta_analysis_table_v3.csv\")\n    json_v2 = os.path.join(WORKDIR, \"hybrid_pcb_vqa_v2.json\")\n    meta_v2 = os.path.join(WORKDIR, \"meta_analysis_table_v2.csv\")\n\n    active_json = json_v3 if os.path.exists(json_v3) else json_v2\n    active_meta = meta_v3 if os.path.exists(meta_v3) else meta_v2\n\n    with open(active_json, \"r\", encoding=\"utf-8\") as f:\n        records = json.load(f)\n    meta_df = pd.read_csv(active_meta)\n\n    if \"Total_V3\" in meta_df.columns:\n        df_fig1 = meta_df[[\"Category\", \"Raw_Pool\", \"Real_Selected\", \"Aug_Train_Added\", \"Train_Total\", \"Val_Real\", \"Test_Real\", \"Total_V3\"]].copy()\n        df_fig1 = df_fig1.rename(columns={\"Total_V3\": \"Final_Total\"})\n    else:\n        df_fig1 = pd.DataFrame({\n            \"Category\": meta_df[\"Category\"],\n            \"Raw_Pool\": meta_df[\"Raw_Unbalanced\"],\n            \"Real_Selected\": meta_df[\"Total_Balanced\"],\n            \"Aug_Train_Added\": 0,\n            \"Train_Total\": meta_df[\"Train_Balanced\"],\n            \"Val_Real\": meta_df[\"Val_Balanced\"],\n            \"Test_Real\": meta_df[\"Test_Balanced\"],\n            \"Final_Total\": meta_df[\"Total_Balanced\"]\n        })\n    df_fig1.to_csv(os.path.join(CSV_CACHE_DIR, \"fig1_class_distribution_data.csv\"), index=False)\n\n    stage_labels = {\n        \"DeepPCB\": \"DeepPCB\\n(Stage 1: Bare Mono)\",\n        \"PKU-Market-PCB\": \"PKU-Market-PCB\\n(Stage 1: Bare RGB)\",\n        \"Amazon-VisA\": \"Amazon-VisA\\n(Stage 2: Assembled PCBA)\",\n        \"SolDef_AI\": \"SolDef_AI\\n(Stage 3: Macro Solder)\"\n    }\n    split_rows = []\n    for src in SOURCES:\n        tr = sum(1 for x in records if x[\"source_dataset\"] == src and x[\"split\"] == \"train\")\n        va = sum(1 for x in records if x[\"source_dataset\"] == src and x[\"split\"] == \"val\")\n        te = sum(1 for x in records if x[\"source_dataset\"] == src and x[\"split\"] == \"test\")\n        split_rows.append({\n            \"source_dataset\": src,\n            \"display_label\": stage_labels[src],\n            \"train_count\": tr,\n            \"val_count\": va,\n            \"test_count\": te,\n            \"total_images\": tr + va + te,\n            \"total_qas\": (tr + va + te) * 4\n        })\n    pd.DataFrame(split_rows).to_csv(os.path.join(CSV_CACHE_DIR, \"fig2_domain_split_data.csv\"), index=False)\n\n    showcase_specs = [\n        (\"A\", \"DeepPCB\", \"pin-hole\", \"Stage 1: Bare Copper PCB  |  Monochrome Optical Scan\"),\n        (\"B\", \"PKU-Market-PCB\", \"missing hole\", \"Stage 1: Bare Copper PCB  |  Full-Colour RGB Capture\"),\n        (\"C\", \"Amazon-VisA\", \"bent pin\", \"Stage 2: Assembled PCBA  |  High-Resolution RGB\"),\n        (\"D\", \"SolDef_AI\", \"solder spike\", \"Stage 3: Macro Solder Joint  |  Close-Up Optical Inspection\")\n    ]\n    showcase_rows = []\n    for letter, src_name, target_cls, stage_desc in showcase_specs:\n        sample = next(\n            (x for x in records if x[\"source_dataset\"] == src_name and x[\"primary_class\"] == target_cls and not x.get(\"is_augmented\", False)),\n            next(x for x in records if x[\"source_dataset\"] == src_name and x[\"primary_class\"] == target_cls)\n        )\n        qa_dict = {qa[\"tier\"]: qa[\"answer\"] for qa in sample[\"qa_pairs\"]}\n        showcase_rows.append({\n            \"panel_letter\": letter,\n            \"source_dataset\": sample[\"source_dataset\"],\n            \"primary_class\": sample[\"primary_class\"],\n            \"stage_description\": stage_desc,\n            \"image_path\": sample[\"image_path\"],\n            \"tier1_answer\": qa_dict[\"Tier 1 - Screening\"],\n            \"tier2_answer\": qa_dict[\"Tier 2 - Classification\"],\n            \"tier3_answer\": qa_dict[\"Tier 3 - Spatial Localisation\"],\n            \"tier4_answer\": qa_dict[\"Tier 4 - Diagnostic Reasoning\"]\n  