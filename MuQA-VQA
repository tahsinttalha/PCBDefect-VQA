{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.18","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":7769008},{"sourceType":"datasetVersion","sourceId":14645878},{"sourceType":"datasetVersion","sourceId":6307674}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# multi-source harmonisation, stratified splitting and leak-free augmentation\nimport os\nimport json\nimport time\nimport random\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image, ImageEnhance\nfrom collections import defaultdict, Counter\nfrom tqdm.auto import tqdm\n\nstart_time = time.time()\nrandom.seed(42)\nnp.random.seed(42)\n\n# downloads the DeepPCB dataset\nif not os.path.exists(\"DeepPCB/PCBData\"):\n    os.system(\"git clone --depth 1 https://github.com/tangsanli5201/DeepPCB.git\")\n\nDEEP_DIR = \"DeepPCB/PCBData\"\nPKU_DIR = \"/kaggle/input/datasets/norbertelter/pcb-defect-dataset/pcb-defect-dataset\"\nVISA_DIR = \"/kaggle/input/datasets/tensura3607/amazon-visa-anomaly\"\nSOLDEF_DIR = \"/kaggle/input/datasets/mauriziocalabrese/soldef-ai-pcb-dataset-for-defect-detection/SolDef_AI/Labeled\"\nAUG_DIR = \"/kaggle/working/augmented_train\"\nos.makedirs(AUG_DIR, exist_ok=True)\n\nPATH_PREFIX_MAP = [\n    (\"/kaggle/input/datasets/norbertelter/pcb-defect-dataset/pcb-defect-dataset/\", \"PKU-Market-PCB/\"),\n    (\"/kaggle/input/datasets/tensura3607/amazon-visa-anomaly/\", \"Amazon-VisA/\"),\n    (\"/kaggle/input/datasets/mauriziocalabrese/soldef-ai-pcb-dataset-for-defect-detection/SolDef_AI/\", \"SolDef_AI/\")\n]\n\nDEEP_CLASSES = {\n    1: \"open\",\n    2: \"short\",\n    3: \"mousebite\",\n    4: \"spur\",\n    5: \"spurious copper\",\n    6: \"pin-hole\"\n}\n\nPKU_CLASSES = {\n    0: \"mousebite\",\n    1: \"spur\",\n    2: \"missing hole\",\n    3: \"short\",\n    4: \"open\",\n    5: \"spurious copper\"\n}\n\nVISA_MAP = {\n    \"melt\": \"melted solder\",\n    \"bent\": \"bent pin\",\n    \"scratch\": \"surface scratch\",\n    \"missing\": \"missing component\",\n    \"extra\": \"extra component\",\n    \"burnt\": \"burnt component\",\n    \"wrong_place\": \"misaligned component\",\n    \"wrong place\": \"misaligned component\",\n    \"dirt\": \"surface contamination\",\n    \"damage\": \"damaged component\"\n}\n\nSOLDEF_MAP = {\n    \"good\": \"clean\",\n    \"exc_solder\": \"excessive solder\",\n    \"poor_solder\": \"insufficient solder\",\n    \"spike\": \"solder spike\",\n    \"no_good\": \"defective solder joint\"\n}\n\nSTAGE_PHRASES = {\n    \"bare_pcb\": \"bare printed circuit board\",\n    \"assembled_pcb\": \"assembled printed circuit board\",\n    \"solder_joint\": \"PCB solder joint\"\n}\n\nDEFECT_EXPLANATIONS = {\n    \"open\": \"An unintended break or gap in a copper trace that interrupts electrical continuity along the circuit path.\",\n    \"short\": \"An unwanted copper bridge connecting two adjacent conductive traces, causing an unintended electrical connection.\",\n    \"mousebite\": \"A ragged, semi-circular notch eaten into the edge of a copper trace, narrowing the conductor and increasing electrical resistance.\",\n    \"spur\": \"An unwanted sharp copper protrusion extending outward from a trace edge, risking an electrical short with neighbouring tracks.\",\n    \"spurious copper\": \"Isolated residual copper debris left on the insulating substrate that should have been etched away during manufacturing.\",\n    \"pin-hole\": \"A tiny microscopic void or pit inside a copper trace or pad that weakens conductor integrity.\",\n    \"missing hole\": \"An undrilled or obstructed via or mounting hole where a through-board connection or component lead aperture is absent.\",\n    \"melted solder\": \"Thermal deformation or reflowed solder pooling across pads or component edges, risking electrical bridging.\",\n    \"bent pin\": \"A mechanically deformed or misaligned integrated circuit lead that fails to make proper contact with its solder pad.\",\n    \"surface scratch\": \"An abrasive score mark across the board surface or solder mask that can expose or sever underlying copper tracks.\",\n    \"missing component\": \"An unpopulated component footprint where a required resistor, capacitor, or integrated circuit was not placed.\",\n    \"extra component\": \"An unintended foreign part or duplicate component lodged on the board assembly.\",\n    \"burnt component\": \"Thermal charring or scorch damage on a mounted component caused by electrical overstress or overheating.\",\n    \"misaligned component\": \"A shifted or rotated surface-mount component whose terminals do not align properly with the PCB pads.\",\n    \"surface contamination\": \"Foreign particulate residue or flux debris on the assembled board that can cause leakage currents.\",\n    \"damaged component\": \"Physical cracking, chipping, or mechanical deformation on a mounted electronic package.\",\n    \"excessive solder\": \"An over-deposited solder fillet forming a bulbous joint that risks bridging adjacent component pads.\",\n    \"insufficient solder\": \"An under-filled solder fillet with incomplete wetting, creating a weak mechanical and electrical connection.\",\n    \"solder spike\": \"A sharp, pointed projection of solder protruding from the joint that can cause short circuits or arcing.\",\n    \"defective solder joint\": \"An irregular or non-conforming solder joint exhibiting poor wetting or structural deformation.\",\n    \"clean\": \"All visible traces, pads, components, and solder joints appear intact with no structural anomalies or electrical faults.\"\n}\n\nGEOM_TRANSFORMS = [\n    \"rot90\",\n    \"rot180\",\n    \"rot270\",\n    \"flip_h\",\n    \"flip_v\",\n    \"rot90_flip_h\",\n    \"rot270_flip_h\",\n    \"identity\"\n]\n\nPHOTO_TRANSFORMS = [\n    \"none\",\n    \"bright_1.12\",\n    \"bright_0.88\",\n    \"contrast_1.15\",\n    \"contrast_0.85\"\n]\n\nALL_AUG_RECIPES = [\n    (g, p) for p in PHOTO_TRANSFORMS for g in GEOM_TRANSFORMS if not (g == \"identity\" and p == \"none\")\n]\n\ndef to_portable_path(raw_path):\n    for old_prefix, new_prefix in PATH_PREFIX_MAP:\n        if raw_path.startswith(old_prefix):\n            return raw_path.replace(old_prefix, new_prefix, 1)\n    return raw_path\n\ndef transform_coords(cx, cy, geom_name):\n    if geom_name == \"identity\":\n        return cx, cy\n    elif geom_name == \"flip_h\":\n        return 1.0 - cx, cy\n    elif geom_name == \"flip_v\":\n        return cx, 1.0 - cy\n    elif geom_name == \"rot90\":\n        return cy, 1.0 - cx\n    elif geom_name == \"rot180\":\n        return 1.0 - cx, 1.0 - cy\n    elif geom_name == \"rot270\":\n        return 1.0 - cy, cx\n    elif geom_name == \"rot90_flip_h\":\n        return 1.0 - cy, 1.0 - cx\n    elif geom_name == \"rot270_flip_h\":\n        return cy, cx\n    return cx, cy\n\ndef apply_optical_transform(pil_img, geom_name, photo_name):\n    img = pil_img.convert(\"RGB\")\n    if geom_name == \"flip_h\":\n        img = img.transpose(Image.Transpose.FLIP_LEFT_RIGHT)\n    elif geom_name == \"flip_v\":\n        img = img.transpose(Image.Transpose.FLIP_TOP_BOTTOM)\n    elif geom_name == \"rot90\":\n        img = img.transpose(Image.Transpose.ROTATE_90)\n    elif geom_name == \"rot180\":\n        img = img.transpose(Image.Transpose.ROTATE_180)\n    elif geom_name == \"rot270\":\n        img = img.transpose(Image.Transpose.ROTATE_270)\n    elif geom_name == \"rot90_flip_h\":\n        img = img.transpose(Image.Transpose.ROTATE_90).transpose(Image.Transpose.FLIP_LEFT_RIGHT)\n    elif geom_name == \"rot270_flip_h\":\n        img = img.transpose(Image.Transpose.ROTATE_270).transpose(Image.Transpose.FLIP_LEFT_RIGHT)\n\n    if photo_name.startswith(\"bright_\"):\n        factor = float(photo_name.split(\"_\")[1])\n        img = ImageEnhance.Brightness(img).enhance(factor)\n    elif photo_name.startswith(\"contrast_\"):\n        factor = float(photo_name.split(\"_\")[1])\n        img = ImageEnhance.Contrast(img).enhance(factor)\n    return img\n\ndef get_region(cx, cy):\n    if 0.35 <= cx <= 0.65 and 0.35 <= cy <= 0.65:\n        return \"centre\"\n    vertical = \"top\" if cy < 0.5 else \"bottom\"\n    horizontal = \"left\" if cx < 0.5 else \"right\"\n    return f\"{vertical}-{horizontal}\"\n\ndef create_vqa_record(\n    image_path, portable_path, source, stage, board_style, split,\n    boxes, rarity_counter, is_augmented=False, aug_transform=\"none\", source_portable_path=None\n):\n    stage_text = STAGE_PHRASES[stage]\n    if not boxes:\n        primary_class = \"clean\"\n        present_classes = []\n        target_defect = \"none\"\n        target_region = \"none\"\n    else:\n        present_classes = sorted({b[0] for b in boxes})\n        target_box = min(boxes, key=lambda b: rarity_counter[b[0]])\n        target_defect, cx, cy = target_box\n        primary_class = target_defect\n        target_region = get_region(cx, cy)\n\n    tier1_ans = \"No\" if primary_class == \"clean\" else \"Yes\"\n    tier2_ans = \"None\" if primary_class == \"clean\" else \", \".join(present_classes)\n    tier3_q = (\n        f\"Are there any defective regions on this {stage_text}?\"\n        if primary_class == \"clean\"\n        else f\"In which region of this {stage_text} is the {target_defect} defect located?\"\n    )\n    tier3_ans = (\n        f\"No, this {stage_text} is defect-free.\"\n        if primary_class == \"clean\"\n        else target_region\n    )\n    tier4_q = (\n        f\"Assess the structural and electrical integrity of this {stage_text}.\"\n        if primary_class == \"clean\"\n        else f\"What is the physical nature and likely electrical impact of the {target_defect} defect visible on this {stage_text}?\"\n    )\n    lookup_key = target_defect if primary_class != \"clean\" else \"clean\"\n    default_desc = f\"A localised {lookup_key} anomaly on the {stage_text} that compromises mechanical reliability or electrical performance.\"\n    tier4_ans = DEFECT_EXPLANATIONS.get(lookup_key, default_desc)\n\n    return {\n        \"image_path\": image_path,\n        \"portable_path\": portable_path,\n        \"source_portable_path\": source_portable_path if source_portable_path else portable_path,\n        \"source_dataset\": source,\n        \"inspection_stage\": stage,\n        \"board_style\": board_style,\n        \"split\": split,\n        \"is_augmented\": is_augmented,\n        \"aug_transform\": aug_transform,\n        \"primary_class\": primary_class,\n        \"all_classes\": present_classes,\n        \"qa_pairs\": [\n            {\n                \"tier\": \"Tier 1 - Screening\",\n                \"question\": f\"Is there any manufacturing defect on this {stage_text}? Answer strictly with Yes or No.\",\n                \"answer\": tier1_ans\n            },\n            {\n                \"tier\": \"Tier 2 - Classification\",\n                \"question\": f\"Which specific defect types are present on this {stage_text}?\",\n                \"answer\": tier2_ans\n            },\n            {\n                \"tier\": \"Tier 3 - Spatial Localisation\",\n                \"question\": tier3_q,\n                \"answer\": tier3_ans\n            },\n            {\n                \"tier\": \"Tier 4 - Diagnostic Reasoning\",\n                \"question\": tier4_q,\n                \"answer\": tier4_ans\n            }\n        ]\n    }\n\npresplit_entries = {\"train\": [], \"val\": [], \"test\": []}\nunsplit_pool = []\nbox_frequency = Counter()\n\nprint(\"[1/5] Parsing DeepPCB (bare monochrome scans)...\", flush=True)\nwith open(os.path.join(DEEP_DIR, \"trainval.txt\"), \"r\") as f:\n    trainval_lines = [line.strip() for line in f if line.strip()]\nrandom.shuffle(trainval_lines)\ndeep_splits = {\"train\": trainval_lines[:850], \"val\": trainval_lines[850:]}\nwith open(os.path.join(DEEP_DIR, \"test.txt\"), \"r\") as f:\n    deep_splits[\"test\"] = [line.strip() for line in f if line.strip()]\n\nfor split, lines in deep_splits.items():\n    for line in tqdm(lines, desc=f\"DeepPCB ({split})\"):\n        img_rel, annot_rel = line.split()\n        temp_path = os.path.join(DEEP_DIR, img_rel.replace(\".jpg\", \"_temp.jpg\"))\n        test_path = os.path.join(DEEP_DIR, img_rel.replace(\".jpg\", \"_test.jpg\"))\n        annot_path = os.path.join(DEEP_DIR, annot_rel)\n        boxes = []\n        with open(annot_path, \"r\") as af:\n            for row in af:\n                parts = row.strip().split()\n                if len(parts) == 5:\n                    x1, y1, x2, y2, cid = map(int, parts)\n                    cx, cy = ((x1 + x2) / 2.0) / 640.0, ((y1 + y2) / 2.0) / 640.0\n                    cname = DEEP_CLASSES[cid]\n                    boxes.append((cname, cx, cy))\n                    box_frequency[cname] += 1\n        presplit_entries[split].append((temp_path, \"DeepPCB\", \"bare_pcb\", \"monochrome_scan\", []))\n        if boxes:\n            presplit_entries[split].append((test_path, \"DeepPCB\", \"bare_pcb\", \"monochrome_scan\", boxes))\n\nprint(\"\\n[2/5] Parsing PKU-Market-PCB (bare RGB photos)...\", flush=True)\nfor split in [\"train\", \"val\", \"test\"]:\n    img_dir = os.path.join(PKU_DIR, split, \"images\")\n    lbl_dir = os.path.join(PKU_DIR, split, \"labels\")\n    img_files = [fn for fn in sorted(os.listdir(img_dir)) if fn.endswith(\".jpg\")]\n    for fn in tqdm(img_files, desc=f\"PKU-PCB ({split})\"):\n        img_path = os.path.join(img_dir, fn)\n        lbl_path = os.path.join(lbl_dir, fn.replace(\".jpg\", \".txt\"))\n        boxes = []\n        if os.path.exists(lbl_path):\n            with open(lbl_path, \"r\") as lf:\n                for row in lf:\n                    parts = row.strip().split()\n                    if len(parts) == 5:\n                        cid = int(parts[0])\n                        cx, cy = float(parts[1]), float(parts[2])\n                        cname = PKU_CLASSES[cid]\n                        boxes.append((cname, cx, cy))\n                        box_frequency[cname] += 1\n        if boxes:\n            presplit_entries[split].append((img_path, \"PKU-Market-PCB\", \"bare_pcb\", \"rgb_photo\", boxes))\n\nprint(\"\\n[3/5] Parsing Amazon VisA pcb1-pcb4 with multi-label splitting...\", flush=True)\nfor subset in [\"pcb1\", \"pcb2\", \"pcb3\", \"pcb4\"]:\n    anno_df = pd.read_csv(os.path.join(VISA_DIR, subset, \"image_anno.csv\"))\n    for _, row in anno_df.iterrows():\n        img_path = os.path.join(VISA_DIR, row[\"image\"])\n        raw_lbl = str(row[\"label\"]).strip().lower()\n        if raw_lbl == \"normal\":\n            unsplit_pool.append((img_path, \"Amazon-VisA\", \"assembled_pcb\", \"rgb_photo\", []))\n        else:\n            mask_path = os.path.join(VISA_DIR, str(row[\"mask\"]))\n            mask_arr = np.array(Image.open(mask_path).convert(\"L\"))\n            ys, xs = np.where(mask_arr > 0)\n            if len(xs) > 0:\n                h, w = mask_arr.shape\n                cx = float((xs.min() + xs.max()) / 2.0 / w)\n                cy = float((ys.min() + ys.max()) / 2.0 / h)\n            else:\n                cx, cy = 0.5, 0.5\n            split_labels = [lbl.strip() for lbl in raw_lbl.split(\",\") if lbl.strip()]\n            boxes = []\n            for sl in split_labels:\n                cname = VISA_MAP.get(sl, sl.replace(\"_\", \" \"))\n                boxes.append((cname, cx, cy))\n                box_frequency[cname] += 1\n            unsplit_pool.append((img_path, \"Amazon-VisA\", \"assembled_pcb\", \"rgb_photo\", boxes))\n\nprint(\"\\n[4/5] Parsing SolDef_AI solder joint inspection...\", flush=True)\nsoldef_jsons = sorted([f for f in os.listdir(SOLDEF_DIR) if f.endswith(\".json\")])\nfor jfn in tqdm(soldef_jsons, desc=\"SolDef_AI (all)\"):\n    img_path = os.path.join(SOLDEF_DIR, jfn.replace(\".json\", \".jpg\"))\n    if not os.path.exists(img_path):\n        continue\n    with open(os.path.join(SOLDEF_DIR, jfn), \"r\") as jf:\n        jdata = json.load(jf)\n    w = float(jdata.get(\"imageWidth\", 1920))\n    h = float(jdata.get(\"imageHeight\", 1080))\n    defect_boxes = []\n    has_good = False\n    for shape in jdata.get(\"shapes\", []):\n        raw_lbl = shape.get(\"label\", \"\")\n        mapped = SOLDEF_MAP.get(raw_lbl)\n        pts = shape.get(\"points\", [])\n        if not mapped or not pts:\n            continue\n        if mapped == \"clean\":\n            has_good = True\n        else:\n            xs = [p[0] for p in pts]\n            ys = [p[1] for p in pts]\n            cx = ((min(xs) + max(xs)) / 2.0) / w\n            cy = ((min(ys) + max(ys)) / 2.0) / h\n            defect_boxes.append((mapped, cx, cy))\n            box_frequency[mapped] += 1\n    if defect_boxes:\n        unsplit_pool.append((img_path, \"SolDef_AI\", \"solder_joint\", \"macro_rgb\", defect_boxes))\n    elif has_good:\n        unsplit_pool.append((img_path, \"SolDef_AI\", \"solder_joint\", \"macro_rgb\", []))\n\nprint(\"\\n[5/5] Applying natural majority fluctuations & leak-free Train-only augmentation...\", flush=True)\nunsplit_by_class = defaultdict(list)\nfor item in unsplit_pool:\n    img_path, src, stage, style, boxes = item\n    p_cls = \"clean\" if not boxes else min(boxes, key=lambda b: box_frequency[b[0]])[0]\n    unsplit_by_class[p_cls].append(item)\n\nfor p_cls, items in unsplit_by_class.items():\n    random.shuffle(items)\n    n = len(items)\n    if n >= 3:\n        n_va = max(1, int(round(0.15 * n)))\n        n_te = max(1, int(round(0.15 * n)))\n        n_tr = max(1, n - n_va - n_te)\n    elif n == 2:\n        n_tr, n_va, n_te = 1, 0, 1\n    else:\n        n_tr, n_va, n_te = 1, 0, 0\n    for it in items[:n_tr]:\n        presplit_entries[\"train\"].append(it)\n    for it in items[n_tr:n_tr + n_va]:\n        presplit_entries[\"val\"].append(it)\n    for it in items[n_tr + n_va:]:\n        presplit_entries[\"test\"].append(it)\n\nraw_entries_by_class = defaultdict(lambda: {\"train\": [], \"val\": [], \"test\": []})\nraw_pool_counts = Counter()\n\nfor split in [\"train\", \"val\", \"test\"]:\n    for entry in presplit_entries[split]:\n        img_path, src, stage, style, boxes = entry\n        p_cls = \"clean\" if not boxes else min(boxes, key=lambda b: box_frequency[b[0]])[0]\n        raw_entries_by_class[p_cls][split].append(entry)\n        raw_pool_counts[p_cls] += 1\n\ndataset_v3 = []\naug_counter = 1\n\nCLEAN_SPLIT_TARGETS = {\"train\": 1020, \"val\": 215, \"test\": 215}\nfor split, target_c in CLEAN_SPLIT_TARGETS.items():\n    by_src = defaultdict(list)\n    for entry in raw_entries_by_class[\"clean\"][split]:\n        by_src[entry[1]].append(entry)\n    srcs = sorted(by_src.keys())\n    for s in srcs:\n        random.shuffle(by_src[s])\n    chosen_clean = []\n    per_s = target_c // len(srcs)\n    for s in srcs:\n        chosen_clean.extend(by_src[s][:per_s])\n    for s in srcs:\n        rem = target_c - len(chosen_clean)\n        if rem > 0:\n            chosen_clean.extend(by_src[s][per_s:per_s + rem])\n    for img_path, src, stage, style, boxes in chosen_clean:\n        p_path = to_portable_path(img_path)\n        dataset_v3.append(create_vqa_record(img_path, p_path, src, stage, style, split, boxes, box_frequency))\n\nfor cls_name in sorted(k for k in raw_pool_counts.keys() if k != \"clean\"):\n    raw_tot = raw_pool_counts[cls_name]\n    tr_pool = raw_entries_by_class[cls_name][\"train\"]\n    va_pool = raw_entries_by_class[cls_name][\"val\"]\n    te_pool = raw_entries_by_class[cls_name][\"test\"]\n\n    if raw_tot > 235:\n        nat_total = int(round(244 + 0.19 * (raw_tot - 1300)))\n        n_va_target = int(round(nat_total * 0.15))\n        n_te_target = int(round(nat_total * 0.15))\n        n_tr_target = nat_total - n_va_target - n_te_target\n\n        for split, pool_list, cap_n in [(\"train\", tr_pool, n_tr_target), (\"val\", va_pool, n_va_target), (\"test\", te_pool, n_te_target)]:\n            by_src = defaultdict(list)\n            for entry in pool_list:\n                by_src[entry[1]].append(entry)\n            for s in by_src:\n                random.shuffle(by_src[s])\n            if len(by_src) == 2:\n                half = cap_n // 2\n                s1, s2 = by_src[\"DeepPCB\"], by_src[\"PKU-Market-PCB\"]\n                t1 = min(len(s1), half)\n                t2 = min(len(s2), cap_n - t1)\n                t1 = min(len(s1), cap_n - t2)\n                selected = s1[:t1] + s2[:t2]\n            else:\n                only_s = list(by_src.keys())[0]\n                selected = by_src[only_s][:cap_n]\n\n            for img_path, src, stage, style, boxes in selected:\n                p_path = to_portable_path(img_path)\n                dataset_v3.append(create_vqa_record(img_path, p_path, src, stage, style, split, boxes, box_frequency))\n    else:\n        for split, pool_list in [(\"train\", tr_pool), (\"val\", va_pool), (\"test\", te_pool)]:\n            for img_path, src, stage, style, boxes in pool_list:\n                p_path = to_portable_path(img_path)\n                dataset_v3.append(create_vqa_record(img_path, p_path, src, stage, style, split, boxes, box_frequency))\n\n        target_class_total = 195 + (raw_tot % 14)\n        needed_aug = max(0, target_class_total - raw_tot)\n\n        if needed_aug > 0 and len(tr_pool) > 0:\n            candidate_pairs = []\n            for base_idx in range(len(tr_pool)):\n                for geom_n, photo_n in ALL_AUG_RECIPES:\n                    candidate_pairs.append((base_idx, geom_n, photo_n))\n            random.shuffle(candidate_pairs)\n            chosen_aug = candidate_pairs[:needed_aug]\n\n            for base_idx, geom_n, photo_n in chosen_aug:\n                img_path, src, stage, style, boxes = tr_pool[base_idx]\n                src_p_path = to_portable_path(img_path)\n                aug_fname = f\"aug_{aug_counter:04d}_{cls_name.replace(' ', '_')}_{geom_n}.jpg\"\n                aug_full_path = os.path.join(AUG_DIR, aug_fname)\n                aug_port_path = f\"augmented_train/{aug_fname}\"\n\n                with Image.open(img_path) as im:\n                    aug_im = apply_optical_transform(im, geom_n, photo_n)\n                    aug_im.save(aug_full_path, format=\"JPEG\", quality=92)\n\n                aug_boxes = []\n                for cname, cx, cy in boxes:\n                    ncx, ncy = transform_coords(cx, cy, geom_n)\n                    aug_boxes.append((cname, ncx, ncy))\n\n                dataset_v3.append(\n                    create_vqa_record(\n                        aug_full_path, aug_port_path, src, stage, style, \"train\",\n                        aug_boxes, box_frequency, is_augmented=True,\n                        aug_transform=f\"{geom_n}+{photo_n}\", source_portable_path=src_p_path\n                    )\n                )\n                aug_counter += 1\n\nrandom.shuffle(dataset_v3)\n\npilot_counts = Counter()\nfor item in dataset_v3:\n    if item[\"split\"] == \"test\" and not item[\"is_augmented\"]:\n        limit = 160 if item[\"primary_class\"] == \"clean\" else 8\n        if pilot_counts[item[\"primary_class\"]] < limit:\n            item[\"is_pilot_test\"] = True\n            pilot_counts[item[\"primary_class\"]] += 1\n        else:\n            item[\"is_pilot_test\"] = False\n    else:\n        item[\"is_pilot_test\"] = False\n\ncanonical_classes = [\"clean\"] + sorted(k for k in raw_pool_counts.keys() if k != \"clean\")\nrows = []\nfor cls in canonical_classes:\n    tr_real = sum(1 for x in dataset_v3 if x[\"split\"] == \"train\" and x[\"primary_class\"] == cls and not x[\"is_augmented\"])\n    tr_aug = sum(1 for x in dataset_v3 if x[\"split\"] == \"train\" and x[\"